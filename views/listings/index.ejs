<% layout("layouts/boilerplate") %> <%=success%>

<!-- <div class="container mt-4"> -->
<!-- <h3 class="mb-3">All Listings</h3> -->
<style>
  #filters {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
  }

  .filter {
    color: #222222;
    text-align: center;
    margin-right: 2rem;
    margin-top: 2rem;
    opacity: 0.7;
    text-decoration: none;
  }

  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }
  .filter p {
    font-size: 0.8rem;
  }
  .active-filter {
    border-bottom: 2px solid #222222;
    opacity: 1;
  }
  .tax-info {
    display: none;
    /* visibility: inherit; */
  }

  .tax-toggle {
    border: 1px solid black;
    border-radius: 1rem;
    height: 3.1rem;
    padding: 1rem;
    margin-left: 2rem;
    display: flex;
    align-items: center;
  }
</style>

<div id="filters">
  <!-- Category icons filter listings through the category query parameter. -->
  <a href="/listings?category=trending" class="filter <%= category === 'trending' ? 'active-filter' : '' %>">
    <i class="fa-solid fa-fire"></i>
    <p>Trending</p>
  </a>
  <a href="/listings?category=mountain" class="filter <%= category === 'mountain' ? 'active-filter' : '' %>">
    <i class="fa-solid fa-mountain"></i>
    <p>Mountain</p>
  </a>
  <a href="/listings?category=room" class="filter <%= category === 'room' ? 'active-filter' : '' %>">
    <i class="fa-solid fa-bed"></i>
    <p>Room</p>
  </a>
  <a href="/listings?category=forest" class="filter <%= category === 'forest' ? 'active-filter' : '' %>">
    <i class="fa-solid fa-tree"></i>
    <p>forest</p>
  </a>
  <a href="/listings?category=cities" class="filter <%= category === 'cities' ? 'active-filter' : '' %>">
    <i class="fa-solid fa-city"></i>
    <p>Cities</p>
  </a>
  <a href="/listings?category=river" class="filter <%= category === 'river' ? 'active-filter' : '' %>">
    <i class="fa-solid fa-water"></i>
    <p>River</p>
  </a>
  <a href="/listings?category=castles" class="filter <%= category === 'castles' ? 'active-filter' : '' %>">
    <i class="fa-brands fa-fort-awesome"></i>
    <p>Castles</p>
  </a>
  <a href="/listings?category=pool" class="filter <%= category === 'pool' ? 'active-filter' : '' %>">
    <i class="fa-solid fa-person-swimming"></i>
    <p>Amazing pool</p>
  </a>
  <a href="/listings?category=camping" class="filter <%= category === 'camping' ? 'active-filter' : '' %>">
    <i class="fa-solid fa-campground"></i>
    <p>Camping</p>
  </a>
  <a href="/listings?category=farms" class="filter <%= category === 'farms' ? 'active-filter' : '' %>">
    <i class="fa-solid fa-tractor"></i>
    <p>Farms</p>
  </a>
  <a href="/listings?category=desert" class="filter <%= category === 'desert' ? 'active-filter' : '' %>">
    <i class="fa-solid fa-gem"></i>
    <p>Desert</p>
  </a>
  <a href="/listings?category=ancient" class="filter <%= category === 'ancient' ? 'active-filter' : '' %>">
    <i class="fa-regular fa-building"></i>
    <p>Ancient</p>
  </a>

  <div class="tax-toggle">
    <div class="form-check form-switch form-check-reverse">
      <input
        class="form-check-input"
        type="checkbox"
        role="switch"
        id="switchCheckChecked"
      />
      <label class="form-check-label" for="switchCheckChecked"
        >Display total amount after taxes</label
      >
    </div>
  </div>
</div>

<% if(search && search.trim()) { %>
  <!-- Shows the active navbar search and gives a quick reset link. -->
  <div class="search-summary mt-3 mb-3">
    Showing results for <b><%= search %></b>
    <a href="/listings" class="ms-2">Clear search</a>
  </div>
<% } %>

<% if(category) { %>
  <!-- Shows the active icon filter and gives a quick reset link. -->
  <div class="search-summary mt-3 mb-3">
    Showing <b><%= category %></b> stays
    <a href="/listings" class="ms-2">Clear filter</a>
  </div>
<% } %>

<% if(allListings.length === 0) { %>
  <div class="empty-search mt-4">
    <h4>No listings found</h4>
    <p>Try searching by another destination, country, or stay name.</p>
  </div>
<% } %>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
  <!-- card start -->
  <% for (let listing of allListings) { %>
  <a href="/listings/<%= listing._id %>" class="listing-link">
    <div class="card col mb-3 listing-card">
      <img
        src="<%= listing.image.url%>"
        class="card-img-top"
        alt="listing_image"
        style="height: 20rem"
      />
      <div class="card-img-overlay"></div>
      <div class="card-body">
        <p class="card-text">
          <b><%= listing.title %></b> <br />
          &#8377;<%=listing.price.toLocaleString("en-IN")%>/night
        </p>
        <div class="listing-card-meta">
          <span><%= listing.location %></span>
          <span class="listing-book-pill">Book Now</span>
        </div>
        <i class="tax-info">&nbsp;&nbsp;+18% GST</i>
        <!--this is creating  equal to the number of list-->
      </div>
    </div>
  </a>
  <% } %>
</div>

<script>
  let taxSwitch = document.getElementById("switchCheckChecked");
  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for (info of taxInfo) {
      if (info.style.display != "inline") {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });
</script>

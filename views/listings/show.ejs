<% layout("layouts/boilerplate")%>

<div class="row">
  <div class="col-8 offset-3 mt-3">
    <h3><%=listing.title%></h3>
  </div>

  <div class="listing-card col-6 offset-3 show-card">
    <img
      src="<%=listing.image.url%>"
      class="card-img-top show-img"
      alt="listing_image"
    />
    <div class="card-body">
      <p class="card-text">
        Owned by <i> <%=listing.owner?listing.owner.username:"unknow" %> </i>
      </p>
      <p class="card-text"><%= listing.description %></p>
      <p class="card-text">
        &#8377; <%= listing.price.toLocaleString("en-IN") %>
      </p>
      <p class="card-text"><%= listing.location %></p>
      <p class="card-text"><%= listing.country %></p>
    </div>
  </div>

  <!-- button -->

  <!-- <div class="btns mb-3">
    <a
      href="/listings/<%= listing._id %>/edit"
      class="btn btn-dark col-1 offset-2 edit-btn"
      >Edit</a
    >
    <br /><br />
    <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
      <button class="btn btn-dark offset-2">Delete</button>
    </form>
  </div> -->

  <div class="show-btn-container">

  <!-- LEFT SIDE -->
  <div class="show-btn-left">
    <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>

      <a
        href="/listings/<%= listing._id %>/edit"
        class="btn edit-btn"
      >Edit</a>

      <form
        method="POST"
        action="/listings/<%=listing._id%>?_method=DELETE"
      >
        <button class="btn btn-dark">Delete</button>
      </form>

    <% } %>
  </div>

  <!-- RIGHT SIDE -->
  <div class="show-btn-right">
    <% if(!currUser) { %>
      <a href="/login" class="btn book-btn">Login to Book</a>
    <% } else if(currUser && (!listing.owner || !listing.owner._id.equals(currUser._id))) { %>
      <a href="#booking-form" class="btn book-btn">
        Book Now &#8377;<%= listing.price.toLocaleString("en-IN") %>
      </a>
    <% } %>
  </div>

</div>

  <% if(currUser && (!listing.owner || !listing.owner._id.equals(currUser._id))) { %>
  <div class="booking-panel col-6 offset-3 mb-4">
    <h4>Book this stay</h4>

    <% if(userBooking) { %>
      <div class="alert alert-success mb-3">
        You booked this stay from
        <b><%= userBooking.checkIn.toLocaleDateString("en-IN") %></b>
        to
        <b><%= userBooking.checkOut.toLocaleDateString("en-IN") %></b>
        for &#8377;<%= userBooking.amount.toLocaleString("en-IN") %>.
      </div>
    <% } %>

    <form
      id="booking-form"
      action="/listings/<%= listing._id %>/bookings"
      method="POST"
      class="needs-validation booking-form"
      data-nightly-price="<%= listing.price %>"
      novalidate
    >
      <div class="row">
        <div class="mb-3 col-md-6">
          <label for="checkIn" class="form-label">Check in</label>
          <input
            type="date"
            class="form-control"
            id="checkIn"
            name="booking[checkIn]"
            required
          />
          <div class="invalid-feedback">Please select a checkin date.</div>
        </div>

        <div class="mb-3 col-md-6">
          <label for="checkOut" class="form-label">Check out</label>
          <input
            type="date"
            class="form-control"
            id="checkOut"
            name="booking[checkOut]"
            required
          />
          <div class="invalid-feedback">Please select a valid checkout date.</div>
        </div>
      </div>

      <div class="row align-items-end">
        <div class="mb-3 col-md-4">
          <label for="guests" class="form-label">Guests</label>
          <input
            type="number"
            class="form-control"
            id="guests"
            name="booking[guests]"
            value="1"
            min="1"
            max="20"
            required
          />
          <div class="invalid-feedback">Guests should be between 1 and 20.</div>
        </div>

        <div class="mb-3 col-md-8">
          <div class="booking-total">
            <span id="bookingNights">Select dates</span>
            <b id="bookingTotal">&#8377;<%= listing.price.toLocaleString("en-IN") %></b>
          </div>
        </div>
      </div>

      <button class="btn book-btn">Confirm Booking</button>
    </form>
  </div>
  <% } %>


  <!-- review section -->
  <div class="col-8 offset-3 mb-3">
    <%if(currUser){%>
    <hr />
    <h4>Leave a Review</h4>
    <form
      action="/listings/<%= listing.id %>/reviews"
      method="POST"
      novalidate
      class="needs-validation"
    >
      <div class="mb-3 mt-3">
        <label for="rating" class="form-label">Rating</label>
        <!-- <input
          type="range"
          class="form-range"
          min="1"
          max="5"
          id="rating"
          name="review[rating]"
        /> -->
        <fieldset class="starability-slot">
          <input
            type="radio"
            id="no-rate"
            class="input-no-rate"
            name="review[rating]"
            value="0"
            checked
            aria-label="No rating."
          />
          <input
            type="radio"
            id="first-rate1"
            name="review[rating]"
            value="1"
          />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input
            type="radio"
            id="first-rate2"
            name="review[rating]"
            value="2"
          />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input
            type="radio"
            id="first-rate3"
            name="review[rating]"
            value="3"
          />
          <label for="first-rate3" title="Average">3 stars</label>
          <input
            type="radio"
            id="first-rate4"
            name="review[rating]"
            value="4"
          />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input
            type="radio"
            id="first-rate5"
            name="review[rating]"
            value="5"
          />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
      </div>
      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea
          name="review[comment]"
          id="comment"
          cols="30"
          rows="5"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Please add some comments for review</div>
      </div>
      <button class="btn btn-outline-dark">Submit</button>
    </form>
    <%}%>
    <hr />
    <p><b>All Reviews</b></p>
    <!-- <p><%=listing.reviews%></p> -->
    <div class="row">
      <% for(review of listing.reviews) { %>
      <div class="card col-5 ms-3 mb-3">
        <div class="card-body">
          <h5 class="card-title">@<%=review.author.username %></h5>
          <p class="card-text"><%=review.comment %></p>
          <p
            class="starability-result card-text"
            data-rating="<%=review.rating%>"
          ></p>

          <form
            class="mb-3"
            method="POST"
            action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE"
          >
            <button class="btn btn-sm btn-dark">Delete</button>
          </form>
        </div>
      </div>
      <%}%>
    </div>
  </div>
</div>
